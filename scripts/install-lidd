#!/bin/sh
set -eu
if [ "$(id -u)" -ne 0 ] || [ "${SUDO_UID:-0}" -eq 0 ] || [ "$#" -ne 1 ]; then
    echo 'Usage: sudo scripts/install-lidd /absolute/path/to/agent-coffee' >&2
    exit 2
fi
label=local.agent-coffee.lidd
plist=/Library/LaunchDaemons/$label.plist
helper=/Library/PrivilegedHelperTools/$label
if [ -e "$plist" ]; then
    echo "A lid helper is already installed at $plist" >&2
    exit 1
fi
/usr/bin/install -d -o root -g wheel -m 755 /Library/PrivilegedHelperTools
/usr/bin/install -o root -g wheel -m 755 "$1" "$helper"
cat > "$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0"><dict>
<key>Label</key><string>$label</string>
<key>ProgramArguments</key><array><string>$helper</string><string>lidd</string><string>$SUDO_UID</string></array>
<key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
<key>StandardErrorPath</key><string>/var/log/agent-coffee-lidd.log</string>
</dict></plist>
PLIST
/usr/sbin/chown root:wheel "$plist"
/bin/chmod 644 "$plist"
if ! /bin/launchctl bootstrap system "$plist"; then
    /bin/rm -f "$plist" "$helper"
    exit 1
fi
